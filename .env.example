# ==========================================================
#  Variables de entorno de PawVet (SOLO NOMBRES Y EJEMPLOS)
#  Copia este archivo como .env y pon tus valores reales.
#  El archivo .env NO se sube al repositorio (.gitignore).
# ==========================================================

# --- Docker (docker compose up) ---
# Clave del usuario sa de SQL Server: minimo 8 caracteres con mayuscula, minuscula, numero y simbolo
MSSQL_SA_PASSWORD=
# Llave del JWT: la MISMA para las dos APIs (la API Clinica firma, la API Agenda valida). Minimo 32 caracteres.
Jwt__Key=
# Usuario Administrador inicial (se crea al primer arranque)
Admin__Email=admin@pawvet.cl
Admin__Password=

# --- Ejecucion local sin Docker (Visual Studio / dotnet run) ---
# configurar-variables.bat las crea por ti usando LocalDB:
# ConnectionStrings__ClinicaDB=Server=(localdb)\MSSQLLocalDB;Database=PawVetClinicaDB;Trusted_Connection=True;TrustServerCertificate=True;
# ConnectionStrings__AgendaDB=Server=(localdb)\MSSQLLocalDB;Database=PawVetAgendaDB;Trusted_Connection=True;TrustServerCertificate=True;
# Servicios__ApiClinica=http://localhost:5001/
