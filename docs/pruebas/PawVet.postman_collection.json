        {
          "name": "Crear ficha de veterinario vinculada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Crear ficha de veterinario vinculada: responde 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('idVeterinario', pm.response.json().idVeterinario);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function rut() {",
                  "  var cuerpo = String(Math.floor(10000000 + Math.random() * 15000000));",
                  "  var suma = 0, m = 2;",
                  "  for (var i = cuerpo.length - 1; i >= 0; i--) { suma += Number(cuerpo[i]) * m; m = m === 7 ? 2 : m + 1; }",
                  "  var r = 11 - (suma % 11);",
                  "  return cuerpo + '-' + (r === 11 ? '0' : r === 10 ? 'K' : String(r));",
                  "}",
                  "pm.collectionVariables.set('rutVet', rut());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{clinica}}/veterinarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rut\": \"{{rutVet}}\",\n  \"nombre\": \"Camila Soto\",\n  \"especialidad\": \"Medicina general\",\n  \"telefono\": \"+56987654321\",\n  \"idUser\": \"{{idUserVet}}\"\n}"
            }
          }
        },
