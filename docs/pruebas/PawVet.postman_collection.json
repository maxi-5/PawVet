    {
      "name": "3. Citas, atenciones y vacunas (API Agenda)",
      "item": [
        {
          "name": "Agendar cita (Recepcionista)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Agendar cita (Recepcionista): responde 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('idCita', pm.response.json().idCita);",
                  "pm.test('Queda Agendada', function () { pm.expect(pm.response.json().estado).to.eql('Agendada'); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// dia futuro aleatorio a las 10:00 (para no toparse con ejecuciones anteriores)",
                  "var d = new Date(); d.setDate(d.getDate() + 20 + Math.floor(Math.random() * 200));",
                  "var f = d.toISOString().slice(0, 10);",
                  "pm.collectionVariables.set('fechaCita', f);",
                  "pm.collectionVariables.set('fechaHoraCita', f + 'T10:00:00');",
                  "pm.collectionVariables.set('fechaHoraTope', f + 'T10:15:00');",
                  "pm.collectionVariables.set('anioFeriado', new Date().getFullYear() + 1);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenRecep}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{agenda}}/citas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idMascota\": \"{{idMascota}}\",\n  \"idVeterinario\": \"{{idVeterinario}}\",\n  \"fechaHora\": \"{{fechaHoraCita}}\",\n  \"duracionMinutos\": 30,\n  \"motivo\": \"Control anual y vacunas\"\n}"
            }
          }
        },
        {
          "name": "Agendar cita que se topa (mismo veterinario)",
